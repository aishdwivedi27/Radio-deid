# Environment overrides for settings.toml (development and CI). Nothing secret.
# DEID_SETTINGS=settings.toml
# DEID_DATA_ROOT=./data
# DEID_OUTPUT_ROOT=./data/output
# DEID_APP_DATA_DIR=./data/app_data
# DEID_INPUT_ROOTS=./data/inbox      (several roots: separate with ';' on Windows, ':' on macOS)
# DEID_PORT=8765
# DEID_BIND_ADDRESS=127.0.0.1        (only 127.0.0.1 is accepted)
