{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Release manifest (SPEC \u00a713.4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "export_type",
    "licensee_id",
    "channel",
    "protocol_version",
    "ec_name",
    "ec_approval_ref",
    "ec_approval_expiry",
    "waiver_cutoff_date",
    "pipeline_version",
    "allowlist_version",
    "rules_version",
    "key_fingerprint",
    "counts",
    "exclusions_by_reason",
    "small_group_suppressed_count",
    "withdrawn_excluded_count",
    "optout_list_version",
    "gate",
    "created_by",
    "created_at"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^R[0-9A-F]{12}$"
    },
    "export_type": {
      "enum": [
        "release",
        "reid_sample",
        "catalogue"
      ]
    },
    "licensee_id": {
      "type": "string"
    },
    "channel": {
      "enum": [
        "marketplace",
        "direct",
        "custom",
        "internal_annotation",
        "reid_test"
      ]
    },
    "dac_approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "protocol_version": {
      "type": "string"
    },
    "ec_name": {
      "type": "string"
    },
    "ec_approval_ref": {
      "type": "string"
    },
    "ec_approval_expiry": {
      "type": "string",
      "format": "date"
    },
    "waiver_cutoff_date": {
      "type": "string",
      "format": "date"
    },
    "consent_basis_counts": {
      "type": "object",
      "properties": {
        "waiver": {
          "type": "integer"
        },
        "consent_flag": {
          "type": "integer"
        }
      }
    },
    "pipeline_version": {
      "type": "string"
    },
    "allowlist_version": {
      "type": "string"
    },
    "rules_version": {
      "type": "string"
    },
    "key_fingerprint": {
      "type": "string"
    },
    "cohort_filter": {
      "type": [
        "object",
        "null"
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "records",
        "images",
        "by_modality"
      ],
      "properties": {
        "records": {
          "type": "integer"
        },
        "images": {
          "type": "integer"
        },
        "by_modality": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "records": {
                "type": "integer"
              },
              "images": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "exclusions_by_reason": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "small_group_suppressed_count": {
      "type": "integer"
    },
    "withdrawn_excluded_count": {
      "type": "integer"
    },
    "optout_list_version": {
      "type": "string"
    },
    "reid_test_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "result"
        ],
        "properties": {
          "check": {
            "enum": [
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6",
              "G7",
              "G8",
              "G9",
              "G10",
              "G11"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "n/a"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}